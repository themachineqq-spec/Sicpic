# Öffentlich, absichtlich im Browser sichtbar. Sicherheit kommt von RLS und dem privaten Bucket.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nur Server. Niemals mit NEXT_PUBLIC_ prefixen und niemals committen.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Öffentliche App-URL ohne Slash am Ende.
# Lokal: http://localhost:3000
# Vercel: https://dein-projekt.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare R2. Der Bucket bleibt privat, kein öffentlicher Zugriff.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sicpic
# Optional. Standard: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Google-Adresse der ersten Admin-Person.
# Beim ersten Login wird sie angelegt, solange es noch keinen Admin gibt.
INITIAL_ADMIN_EMAIL=du@example.com

# Lebensdauer signierter Bild-URLs in Sekunden. Erlaubt: 60 bis 600. Standard: 300.
PRESIGN_EXPIRES_SECONDS=300
